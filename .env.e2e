# e2e 테스트 전용 환경 — 로컬 Postgres 컨테이너(docker-compose.e2e.yml) 사용
# 비밀값이 없으므로 커밋 대상 (.gitignore에서 예외 처리)
DATABASE_URL=postgresql://medirok:medirok@localhost:54329/medirok_e2e
PAYLOAD_SECRET=e2e-local-secret
DASHBOARD_PASSWORD=meirok5349

# 이미지 저장소를 반드시 로컬 디스크로 묶는다.
# next dev는 .env.local을 자동 로드하므로, 비워두지 않으면 로컬 개발·e2e가
# **운영 Vercel Blob**을 읽고 쓴다(로컬 업로드가 운영 저장소에 올라간다).
# 빈 문자열이면 payload.config의 enabled 게이트가 false가 되어 media/로 폴백한다.
BLOB_READ_WRITE_TOKEN=
