# Payload CMS
PAYLOAD_SECRET=replace-with-32-char-random-string-please

# Postgres — Neon (Vercel 통합 시 DATABASE_URL 자동 주입)
# 런타임(서버리스)은 pooled 연결 사용
DATABASE_URL=postgres://user:pass@host-pooler.neon.tech/medirok?sslmode=require
# 마이그레이션/스키마 push 등 DDL 작업은 직결(UNPOOLED) 권장
DATABASE_URL_UNPOOLED=postgres://user:pass@host.neon.tech/medirok?sslmode=require

# 이미지 저장소 — Vercel Blob (Vercel 통합 시 자동 주입)
# 미설정 시 Media는 로컬 디스크로 폴백한다. 운영에서 비어 있으면 어드민 업로드가
# 저장되지 않으므로 Production/Preview 양쪽에 반드시 주입할 것.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dashboard (자체 관리 UI) — 단일 비밀번호
DASHBOARD_PASSWORD=meirok5349
